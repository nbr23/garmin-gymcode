# Copy to .env and fill in. scripts/gen-config.sh turns it into source/BuildConfig.mc at build time.

# Built-in memberships as Name:code entries separated by ';', in the order they cycle on the watch.
# Optional: codes can also be added on the watch (hold UP), listed after these.
# Codes must be digits only (Code 39 numeric).
MEMBERSHIPS=Gym:87654321;Pool:12345678
